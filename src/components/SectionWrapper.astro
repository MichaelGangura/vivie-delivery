---
---

<div class="flex flex-col justify-center items-center gap-[24px] mx-auto z-[1] w-full max-w-[1200px] px-4 box-border my-6">
    <!-- Parameters Card -->
    <section class="parameters m-reveal-left m-delay-2 flex flex-col justify-center gap-[16px] bg-box-a font-jura text-[19px] sm:text-[20px] tracking-[2px] font-bold text-white z-[1] border-[4px] border-box-p p-[20px] sm:p-[24px] w-full max-w-[650px] box-border shadow-lg rounded-sm transition-transform duration-300 hover:translate-y-[-2px]">
        <h2 class="font-jura text-[24px] sm:text-[27px] text-white text-center font-bold tracking-[2px] z-[1] flex items-center justify-center gap-2">
            <span>Характеристики авто:</span>
        </h2>
        
        <p class="text-center leading-relaxed text-gray-100">
            Вантажний бус <span class="text-[#fda128] font-extrabold">Opel Vivaro</span><br />
            Навантаження <span class="text-[#fda128] font-extrabold">до 1000 кг</span>
        </p>

        <!-- Animated mobile load capacity visual bar -->
        <div class="w-full bg-gray-800/60 rounded-full h-3.5 p-0.5 border border-white/20 overflow-hidden my-1">
            <div class="bg-gradient-to-r from-amber-500 via-amber-400 to-amber-300 h-full rounded-full w-[95%] transition-all duration-1000 ease-out shadow-[0_0_12px_rgba(253,161,40,0.6)]"></div>
        </div>

        <div class="bg-black/20 rounded-md p-3 text-center border border-white/10 flex flex-col gap-1 text-[17px] sm:text-[18px]">
            <span class="text-[#fda128] font-bold tracking-wider text-[15px] uppercase">Місткість для вантажу:</span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mt-1">
                <div class="bg-white/10 p-2 rounded border border-white/10 transition-transform duration-200 hover:scale-105">
                    📏 Довжина: <span class="text-amber-300">2.5 м</span><br/>
                    <span class="text-[13px] font-normal text-gray-300">(зверху 2.0м)</span>
                </div>
                <div class="bg-white/10 p-2 rounded border border-white/10 transition-transform duration-200 hover:scale-105">
                    ↔️ Ширина: <span class="text-amber-300">1.25 м</span><br/>
                    <span class="text-[13px] font-normal text-gray-300">(у ширшому 1.5м)</span>
                </div>
                <div class="bg-white/10 p-2 rounded border border-white/10 transition-transform duration-200 hover:scale-105">
                    ↕️ Висота: <span class="text-amber-300">1.35 м</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Contacts Card -->
    <section class="contacts m-reveal-right m-delay-3 flex flex-col justify-center gap-[20px] bg-box-a font-jura text-[20px] tracking-[2px] font-bold text-white z-[1] border-[4px] border-box-p p-[20px] sm:p-[24px] w-full max-w-[650px] box-border shadow-lg rounded-sm transition-transform duration-300 hover:translate-y-[-2px]">
        <h2 class="font-jura text-[24px] sm:text-[27px] text-white text-center font-bold tracking-[2px] z-[1]"> Контакти:</h2>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
            <!-- Interactive Messengers with tactile mobile touch response -->
            <div class="flex items-center gap-3 bg-black/20 px-4 py-2 rounded-full border border-white/10">
                <a href="viber://chat?number=%2B380965651211" target="_blank" rel="noopener noreferrer" class="transition-transform duration-300 hover:scale-125 active:scale-90 hover:rotate-6 hover:drop-shadow-[0_0_10px_rgba(115,96,242,0.8)]" title="Viber">
                    <img src="/assets/viber_svgrepo.com2.svg" alt="viber" class="w-8 h-8" />
                </a>
                <a href="https://t.me/+380965651211" target="_blank" rel="noopener noreferrer" class="transition-transform duration-300 hover:scale-125 active:scale-90 hover:-rotate-6 hover:drop-shadow-[0_0_10px_rgba(34,158,217,0.8)]" title="Telegram">
                    <img src="/assets/telegram_svgrepo.svg" alt="telegram" class="w-8 h-8" />
                </a>
                <a href="https://wa.me/380965651211" target="_blank" rel="noopener noreferrer" class="transition-transform duration-300 hover:scale-125 active:scale-90 hover:rotate-6 hover:drop-shadow-[0_0_10px_rgba(37,211,102,0.8)]" title="WhatsApp">
                    <img src="/assets/whatsapp_svgrepo.com2.svg" alt="whatsapp" class="w-8 h-8" />
                </a>
            </div>

            <!-- Pulsating glowing call CTA button -->
            <a class="phone animate-call-pulse bg-[#fda128] text-gray-900 font-extrabold text-[22px] sm:text-[26px] no-underline px-6 py-2.5 rounded-full hover:bg-amber-300 transition-all duration-300 flex items-center justify-center gap-2 shadow-md active:scale-95 text-center" href="tel:+380965651211">
                <span>096 565 1211</span>
            </a>
        </div>
    </section>
</div>

