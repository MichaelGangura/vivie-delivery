---

<header class="flex flex-col items-center justify-center w-[90%] max-w-[600px] mx-auto gap-[16px] pt-[30px] pb-[10px]">
    <!-- Mobile/Tablet live status indicator -->
    <div class="m-reveal m-delay-1 flex items-center gap-2 px-3.5 py-1 bg-white/90 backdrop-blur border border-[#fda128]/50 rounded-full shadow-sm text-gray-800 text-[13px] sm:text-[14px] font-bold tracking-wider transition-transform duration-300 hover:scale-105 active:scale-95">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-live-dot inline-block"></span>
        <span>Стрий • область • Україна</span>
    </div>

    <!-- Animated logo with soft tilt and touch response -->
    <div class="m-reveal-scale m-delay-2 w-[75%] sm:w-[50%] max-w-[340px] transition-transform duration-500 hover:scale-105 active:scale-95 cursor-pointer">
        <img src="/assets/logo.png" alt="Vivie Delivery Logo" class="w-full h-auto drop-shadow-sm" />
    </div>

    <h1 class="m-reveal m-delay-3 font-jura text-[26px] sm:text-[34px] max-430:text-[22px] text-black text-center tracking-[3px] font-bold z-[1] leading-tight">
        Приватні вантажні перевезення бусом
    </h1>
</header>

