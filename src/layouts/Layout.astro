---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Вантажні перевезення бусом у Стрию, області та інших областях України',
	description = 'Вантажне таксі. Перевезення будівельних матеріалів, речей, меблів, побутової техніки, інше.'
} = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "MovingCompany",
  "name": "Вантажні перевезення бусом Opel Vivaro",
  "description": "Вантажне таксі. Перевезення будівельних матеріалів, речей, меблів, побутової техніки, інше.",
  "url": "https://vivie-delivery.pp.ua",
  "telephone": "+380965651211",
  "priceRange": "UAH",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Стрий",
    "addressRegion": "Львівська область",
    "addressCountry": "UA"
  },
  "areaServed": [
    "Стрий",
    "Львівська область",
    "Україна"
  ],
  "owner": {
    "@type": "Person",
    "name": "Гангура Михайло Олексійович"
  },
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "Приватні вантажні перевезення бусом"
    }
  }
};
---

<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schemaData, null, 2)} />
    <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
</head>

<body class="font-jura antialiased selection:bg-box-p selection:text-white relative">
    <slot />


    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // High-performance IntersectionObserver for Mobile & Tablet Scroll Reveals
            const observerOptions = {
                root: null,
                rootMargin: '0px 0px -40px 0px',
                threshold: 0.08
            };

            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                    }
                });
            }, observerOptions);

            const revealElements = document.querySelectorAll('.m-reveal, .m-reveal-left, .m-reveal-right, .m-reveal-scale');
            revealElements.forEach(el => revealObserver.observe(el));

            // Floating mobile quick-call button toggle on scroll
            const floatingBtn = document.getElementById('floating-call-btn');
            if (floatingBtn) {
                window.addEventListener('scroll', () => {
                    if (window.scrollY > 160) {
                        floatingBtn.classList.remove('translate-y-24', 'opacity-0');
                        floatingBtn.classList.add('translate-y-0', 'opacity-100');
                    } else {
                        floatingBtn.classList.remove('translate-y-0', 'opacity-100');
                        floatingBtn.classList.add('translate-y-24', 'opacity-0');
                    }
                }, { passive: true });
            }
        });
    </script>
</body>

</html>

