{
  "version": 1.1,
  "atDirectives": [
    {
      "name": "@tailwind",
      "description": "Inserts Tailwind's `base`, `components`, `utilities` or `screens` styles.",
      "references": [
        {
          "name": "Tailwind Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives#tailwind"
        }
      ]
    },
    {
      "name": "@apply",
      "description": "Applies utility classes inline.",
      "references": [
        {
          "name": "Tailwind Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives#apply"
        }
      ]
    },
    {
      "name": "@layer",
      "description": "Declares which bucket a set of custom styles belong to.",
      "references": [
        {
          "name": "Tailwind Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives#layer"
        }
      ]
    },
    {
      "name": "@config",
      "description": "Specifies which config file Tailwind should use.",
      "references": [
        {
          "name": "Tailwind Documentation",
          "url": "https://tailwindcss.com/docs/functions-and-directives#config"
        }
      ]
    }
  ]
}
